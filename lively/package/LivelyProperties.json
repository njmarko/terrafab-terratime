{
  "labelView": { "type": "label", "value": "View" },
  "zoom": { "type": "slider", "text": "Zoom", "help": "0 = whole photo, 100 = dial fills the screen (the site's zoom)", "min": 0, "max": 100, "step": 1, "value": 0 },
  "smoothSeconds": { "type": "checkbox", "text": "Smooth second hand", "help": "Off: the second hand ticks once a second and the page redraws once a second (less GPU/CPU)", "value": true },
  "labelHeader": { "type": "label", "value": "Header" },
  "showInterface": { "type": "checkbox", "text": "Show header (all)", "value": true },
  "showTitle": { "type": "checkbox", "text": "Title", "value": true },
  "showTime": { "type": "checkbox", "text": "Time", "value": true },
  "showDate": { "type": "checkbox", "text": "Date", "value": true },
  "showLive": { "type": "checkbox", "text": "LIVE line", "value": true },
  "showCredit": { "type": "checkbox", "text": "Made by", "value": true },
  "labelFace": { "type": "label", "value": "Face" },
  "lines": { "type": "dropdown", "text": "Lines", "items": ["Off", "Hours", "Both"], "value": 2 },
  "lineColor": { "type": "color", "text": "Line color", "value": "#2a3645" },
  "lineThickness": { "type": "slider", "text": "Line thickness", "min": 1, "max": 10, "step": 0.5, "value": 2 },
  "numerals": { "type": "dropdown", "text": "Numerals", "items": ["Off", "12", "XII"], "value": 0 },
  "numeralPlace": { "type": "dropdown", "text": "Numeral place", "items": ["Inside", "Outside"], "value": 0 },
  "numeralColor": { "type": "color", "text": "Numeral color", "value": "#2a3645" },
  "numeralThickness": { "type": "slider", "text": "Numeral thickness", "min": 3, "max": 14, "step": 0.5, "value": 7 },
  "fitRoad": { "type": "checkbox", "text": "Fit the road", "help": "Off: place the face with the three sliders below", "value": true },
  "faceAcross": { "type": "slider", "text": "Face across", "min": 10, "max": 90, "step": 0.5, "value": 50.5 },
  "faceDown": { "type": "slider", "text": "Face down", "min": 10, "max": 90, "step": 0.5, "value": 49 },
  "faceSize": { "type": "slider", "text": "Face size", "min": 12, "max": 70, "step": 0.5, "value": 28.5 },
  "labelHands": { "type": "label", "value": "Hands" },
  "hourHand": { "type": "slider", "text": "Hour hand", "min": 10, "max": 180, "step": 1, "value": 35 },
  "minuteHand": { "type": "slider", "text": "Minute hand", "min": 10, "max": 180, "step": 1, "value": 52 },
  "secondHand": { "type": "slider", "text": "Second hand", "min": 10, "max": 180, "step": 1, "value": 55 },
  "stackByLength": { "type": "checkbox", "text": "Stack by length (shortest in front)", "value": false },
  "labelBlur": { "type": "label", "value": "Blur" },
  "blur": { "type": "slider", "text": "Blur", "help": "Glass bands beside the photo; 0 = off", "min": 0, "max": 48, "step": 1, "value": 18 },
  "unblurPastPhoto": { "type": "checkbox", "text": "Unblur past the photo", "value": true }
}
